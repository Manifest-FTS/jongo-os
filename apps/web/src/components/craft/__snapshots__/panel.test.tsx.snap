// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pages: flag off renders nothing new and looks nothing up > team page flag-off markup is stable (committed snapshot, identical to the pre-Craft page) 1`] = `"<div class="page-stack"><article class="card"><h2 style="margin-top:0;display:flex;align-items:center;gap:0.5rem">App Team<span title="Client-level invites are now the preferred path for granting access across all apps in a project." aria-label="Pending: Client-level invites are now the preferred path for granting access across all apps in a project." style="display:inline-flex;align-items:center;gap:0.22rem;font-size:0.68rem;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:var(--muted);background:color-mix(in srgb, var(--surface-alt, #f4f4f4) 80%, transparent);border:1px solid var(--border, #e2e2e2);border-radius:4px;padding:0.1rem 0.38rem;cursor:help;vertical-align:middle;line-height:1.4;user-select:none;flex-shrink:0"><span aria-hidden="true" style="display:inline-block;width:6px;height:6px;border-radius:50%;border:1.5px solid currentColor;opacity:0.7"></span>pending</span></h2><p class="card-muted" style="margin-bottom:1rem">Manage access from the client/project team page so invited users automatically inherit access to every app in this client.</p><div style="display:grid;gap:0.85rem"><div style="padding:0.9rem 1rem;border:1px solid var(--border);border-radius:12px;background:var(--surface)"><p style="margin:0;font-weight:600">Use client-level invites</p><p class="card-muted" style="margin:0.25rem 0 0">App/resource-specific invites are being phased out in the UI. Manage admins and collaborators once at the client level instead.</p></div><div><a class="btn" href="/clients/client-1/team">Open client team</a></div></div></article></div>"`;
