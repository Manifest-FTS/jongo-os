# jongo-os Phase 1 Environment Configuration
# Copy this to .env and fill in your actual values
# This file should be committed to the repository (use .env.local for secrets)

# ============================================================
# Application
# ============================================================

# Node environment: development, production, test
NODE_ENV=development

# Public-facing base URL
NEXTAUTH_URL=http://localhost:3000

# Secret for NextAuth.js signing and encryption
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# Optional local-dev helper: when auth env is missing, APIs can impersonate
# this user to unblock local workflows (create client/site/collaborators).
# DEV_AUTH_EMAIL=devkev@manifestfts.com
# DEV_AUTH_PASSWORD=local-dev-login

# Bootstrap admin account (if this email matches the signed-in user,
# client/site repository queries run with global visibility)
# BOOTSTRAP_ADMIN_EMAIL=owner@manifestfts.com

# ============================================================
# Database
# ============================================================

# PostgreSQL connection string.
# Local development should point at the SSH tunnel on localhost:5433.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://jongo:password@localhost:5433/jongo_dev

# Database logging (useful for development; turn off in production)
DATABASE_LOG=query,warn,error

# ============================================================
# Coolify Integration
# ============================================================

# Coolify API Base URL (where your Coolify instance is hosted)
COOLIFY_API_BASE_URL=http://coolify.local/api

# Coolify API Token (generate in Coolify dashboard)
COOLIFY_API_TOKEN=your-coolify-api-token-here

# Coolify API request timeout in milliseconds
COOLIFY_TIMEOUT_MS=8000

# ============================================================
# Storage and Backups
# ============================================================

# Storage backend: 'local' or 's3'
STORAGE_BACKEND=local

# Local storage path (used if STORAGE_BACKEND=local)
STORAGE_LOCAL_PATH=/data/jongo/storage

# S3 configuration (used if STORAGE_BACKEND=s3)
S3_BUCKET=jongo-backups
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT= # optional: for S3-compatible services (Minio, etc.)

# ============================================================
# Email (for invitations and transactional messages)
# ============================================================
# Jongo OS uses Nodemailer for transactional SMTP delivery.
# This configuration is APP-LEVEL, not Coolify-global.
# Store these as Jongo app environment variables in Coolify, not server-level.

# SMTP Configuration (all required if email delivery is desired)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@jongo.local
SMTP_TLS=true
# Optional provider hint for logging/debugging: 'smtp2go' or 'smtp'
SMTP_PROVIDER=

# Invite Configuration
# Optional: invite-url base. Defaults to NEXTAUTH_URL.
INVITE_BASE_URL=

# Optional: invite token hash pepper. Defaults to NEXTAUTH_SECRET.
INVITE_TOKEN_SECRET=

# Optional: invite validity period in days. Default is 7.
INVITE_TTL_DAYS=7

# ============================================================
# Logging and Monitoring
# ============================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Logging backend: 'console' or 'file'
LOG_BACKEND=console

# Log file path (used if LOG_BACKEND=file)
LOG_FILE_PATH=/var/log/jongo/app.log

# ============================================================
# Security
# ============================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Password minimum length
PASSWORD_MIN_LENGTH=12

# Session timeout in hours
SESSION_TIMEOUT_HOURS=24

# Allow users to create accounts via /auth/register
# Keep disabled in private/internal deployments.
ENABLE_SELF_REGISTRATION=false

# ============================================================
# Feature Flags
# ============================================================

# Enable experimental features
FEATURE_EXPERIMENTAL=false

# Enable API tokens (programmatic access)
FEATURE_API_TOKENS=true

# Enable audit logging
FEATURE_AUDIT_LOGS=true

# ============================================================
# Analytics and Telemetry (optional)
# ============================================================

# Disable anonymous telemetry (keep true for privacy in self-hosted)
TELEMETRY_DISABLED=true

# ============================================================
# Developer Settings
# ============================================================

# Enable detailed error pages in development
DEBUG=false

# Enable API request/response logging
API_DEBUG=false
