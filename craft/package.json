{
  "name": "@jongo/craft",
  "version": "0.1.0-preview.15",
  "description": "Bounded Craft shell, neutral Sanity-style content studio, fictional Golf Lab review extension, a server-only Postgres persistence subpath and server-only Sign in with Jongo relying-party helpers; preview, not production-ready",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    },
    "./golf-lab": {
      "types": "./dist/golf-lab/index.d.ts",
      "import": "./dist/golf-lab/index.js"
    },
    "./logic": {
      "types": "./dist/golf-lab/logic.d.ts",
      "import": "./dist/golf-lab/logic.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./studio.css": "./dist/studio.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:db": "npm run build && node scripts/test-db.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "groq-js": "^2.0.1",
    "jose": "^6.2.15",
    "pg": "^8.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "groq-js": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "groq-js": "^2.0.1",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
