// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum GlobalRole {
  super_admin
  admin
  collaborator
}

enum ClientBillingMode {
  manual_override
  bonsai
  native_stripe
  exempt
}

enum ClientBillingStatus {
  active_paid
  past_due
  pending_setup
  comped
}

enum CollaboratorRole {
  admin
  collaborator
}

enum SiteCollaboratorRole {
  admin
  collaborator
}

enum NotificationType {
  system_backup
  suspension
  maintenance
  general
}

enum NotificationDeliveryMode {
  in_app
  email
  in_app_and_email
}

// ============================================================
// Users and Authentication
// ============================================================

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  passwordHash    String?
  fullName        String?
  avatarUrl       String?
  authProvider    String? // 'local', 'github', 'google', etc.
  authProviderId  String? // external provider ID
  role            GlobalRole @default(collaborator)

  // Billing (Stripe). Subscription is per-account, not per-organization: a
  // user's plan caps the usage across every client/org they create, so there
  // is one subscription to track here rather than one per Organization.
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @unique
  subscriptionPlanId           String? // TierPlan.id from lib/public-plans.ts
  subscriptionInterval         String? // 'monthly' | 'annual'
  subscriptionStatus           String? // Stripe subscription status, e.g. 'active', 'past_due', 'canceled'
  subscriptionCurrentPeriodEnd DateTime?

  // Relations
  profileSettings      UserProfileSettings?
  organizations        Organization[]
  collaborations       Collaborator[]
  siteCollaborations   SiteCollaborator[]
  apiTokens            ApiToken[]
  auditLogs            AuditLog[]
  favoriteApps         UserFavoriteApp[]
  deploymentsTriggered Deployment[]         @relation("TriggeredBy")
  collaboratorsGranted Collaborator[]       @relation("GrantedBy")
  invitationsSent      Invitation[]         @relation("InvitationInvitedBy")
  invitationsAccepted  Invitation[]         @relation("InvitationAcceptedBy")
  passwordResetTokens  PasswordResetToken[]
  notifications        Notification[]
  broadcastsSent       NotificationBroadcast[]
  platformAdminGrant   PlatformAdmin?          @relation("PlatformAdminUser")
  platformAdminsGranted PlatformAdmin[]        @relation("PlatformAdminGrantedBy")
  cmsDatasetGrants     CmsDatasetGrant[]
  cmsRevisions         CmsRevision[]
  cmsMutations         CmsMutation[]
  cmsMarketingReleases CmsMarketingRelease[]
  cmsMarketingPublications CmsMarketingPublication[]
  cmsDeliveryCredentials CmsDeliveryCredential[]
  cmsContentOutboxEvents CmsContentOutbox[]
  cmsMediaCreated CmsApprovedMedia[] @relation("CmsMediaCreator")
  cmsMediaReviewed CmsApprovedMedia[] @relation("CmsMediaReviewer")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([authProviderId])
}

model UserProfileSettings {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String    @unique @db.Uuid
  username                  String?   @unique
  profileRole               String?
  emailNotificationsEnabled Boolean   @default(true)
  backupAlertsEnabled       Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

model UserFavoriteApp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  appId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([userId])
  @@index([appId])
}

// ============================================================
// Organizations
// ============================================================

model Organization {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String  @unique
  name               String
  description        String?
  logoUrl            String?
  ownerId            String  @db.Uuid
  coolifyApiUrl      String? // optional per-org override
  coolifyProjectId   String? @unique
  coolifyProjectName String?

  // Client receivables are independent of the owner's account subscription.
  billingMode        ClientBillingMode   @default(manual_override)
  billingStatus      ClientBillingStatus @default(pending_setup)
  billingNotes       String?            @db.Text
  bonsaiClientId     String?
  externalInvoiceUrl String?

  // Relations
  owner               User                             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sites               Site[]
  coolifyProjectLinks OrganizationCoolifyProjectLink[]
  collaborators       Collaborator[]
  invitations         Invitation[]
  apiTokens           ApiToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  domains             Domain[]
  githubInstallations GithubInstallation[]
  githubApps          GithubAppConfig[]
  cmsDatasets         CmsDataset[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  NotificationChannel NotificationChannel[]

  @@index([ownerId])
  @@index([slug])
  @@index([coolifyProjectName])
}

model OrganizationCoolifyProjectLink {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @db.Uuid
  coolifyProjectId   String
  coolifyProjectName String?
  isPrimary          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, coolifyProjectId])
  @@index([organizationId])
  @@index([coolifyProjectId])
  @@index([coolifyProjectName])
}

// ============================================================
// Sites / Applications
// ============================================================

model Site {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String  @db.Uuid
  slug                  String
  name                  String
  description           String?
  coolifyServiceId      String? // external Coolify service ID
  coolifyServiceUuid    String? // Coolify service UUID
  coolifyProjectId      String? // Coolify project UUID/ID for ownership mapping
  coolifyProjectName    String?
  gitRepositoryUrl      String?
  stagingEnabled        Boolean @default(false)
  // The Coolify resource Jongo created or re-attached as this app's staging
  // copy. Names alone could not tie "staging-acme" to "acme.org", so turning
  // staging off left the copy running and turning it on built a second one.
  // Set on enable, cleared when disable removes the copy.
  stagingTargetUuid     String?
  // External data services (Sanity, Neon, …) the staging copy shares with
  // production, comma-separated; shown as a warning on the staging page.
  stagingSharedServices String?
  temporaryDomainSlug   String?
  temporaryDomainSuffix String?

  // Deploy from the customer's own GitHub (lib/github-deploys.ts). gitRepoId
  // survives renames; gitStatus: linked | repo_access_lost | install_removed |
  // install_suspended. pendingCommit* is set when autoDeploy is off.
  githubInstallationId String?             @db.Uuid
  githubInstallation   GithubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  gitRepoFullName      String?
  gitRepoId            String? // GitHub repo id as text (ids outgrow int32; BigInt breaks JSON)
  gitBranch            String?
  gitStagingBranch     String?
  autoDeploy           Boolean             @default(true)
  gitStatus            String?
  pendingCommitSha     String?
  pendingCommitMessage String?
  lastDeployedSha      String?

  // Maintained by the hourly reconciler (see lib/platform-reconcile.ts).
  // isStagingResource: this Site's Coolify resource lives in a staging
  // environment, so it is a staging counterpart rather than a production app.
  // resourceMissingSince: its Coolify resource could not be found; set so the
  // UI can surface orphans instead of silently showing an empty app.
  isStagingResource    Boolean   @default(false)
  resourceMissingSince DateTime?

  // Scheduled backups. backupScheduleEnabled is nullable on purpose: null means
  // "follow the platform default", so the feature can be rolled out globally
  // without writing a row per site, while still allowing per-site opt-out.
  backupScheduleEnabled  Boolean?
  backupFrequencyHours   Int       @default(24)
  lastScheduledBackupAt  DateTime?
  // Cached answer to "does this resource have anything worth snapshotting?".
  // Null = never evaluated. Cached because the scheduler must not fan out an
  // API call per site every hour, and stale-by-a-day is harmless: the on-demand
  // path re-checks live before it ever starts a run.
  backupEligible         Boolean?
  backupEligibleAt       DateTime?
  // Why: "stateless", "external_database", "linked_database", ... Cached beside
  // backupEligible so the UI can decide what to show without a Coolify call on
  // every page load.
  backupCapabilityReason String?
  // Privacy Mode: HTTP Basic Auth in front of the live site, so a pre-launch or
  // mid-rework site can be shared with a client without being publicly readable
  // or indexable. Enforcement is a Traefik router written to the proxy's watched
  // dynamic directory — see lib/privacy-mode.ts.
  //
  // privacyModePassword is stored in PLAINTEXT, deliberately. The product shows
  // the current credentials so an operator can hand them to a client, which a
  // hash cannot support. It gates a not-yet-public site rather than an account,
  // and it is never returned to a caller who cannot already manage the site.
  privacyModeEnabled       Boolean   @default(false)
  privacyModeUsername      String?
  privacyModePassword      String?
  privacyModeUpdatedAt     DateTime?
  privacyModeUpdatedBy     String?   @db.Uuid
  // Whether the proxy actually reflects the flag above: 'applied' | 'failed'.
  // Separate from privacyModeEnabled because the database write and the proxy
  // change can disagree, and a site that believes it is private while serving
  // publicly is the one outcome this feature must never report as success.
  privacyModeProviderState String?
  privacyModeProviderError String?

  // Set on a database resource that belongs to another app: Coolify registers
  // standalone databases as their own resources, so they were imported as
  // peer apps and listed next to the app that owns them. Maintained by the
  // hourly reconciler from live Coolify links, so apps added later nest with
  // no manual step. Deliberately a plain id, not a relation, to avoid a
  // self-referential cascade on a table that is soft-deleted.
  parentSiteId           String?   @db.Uuid
  // When Coolify's backup schedules were last reconciled for this app. The
  // sweep re-checked all 43 apps every hour, which alone exceeds Coolify's
  // 200 requests/minute, starving everything that ran after it.
  scheduleCheckedAt      DateTime?
  // Rate limit for scheduled-backup failure email. A site that is broken fails
  // every night, and a nightly alert trains people to ignore alerts.
  backupAlertSentAt      DateTime?
  // Note: Site is referred to as "App" in UI/UX language

  // Relations
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stagingDomains StagingDomain[]
  stagingDatabases StagingDatabase[]
  environments             Environment[]
  collaborators            SiteCollaborator[]
  invitations              Invitation[]
  wordpressTelemetryConfig WordPressTelemetryConfig?
  wordpressPluginInventory WordPressPluginInventory?
  backups                  SiteBackup[]
  sftpAccounts             SftpAccount[]
  notifications            Notification[]
  cmsDatasets              CmsDataset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([githubInstallationId, gitRepoId])
  @@index([organizationId])
  @@index([coolifyServiceId])
  @@index([coolifyProjectId])
  @@index([coolifyProjectName])
}

model WordPressTelemetryConfig {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId             String    @unique @db.Uuid
  siteUrl            String
  username           String
  passwordCiphertext String
  lastTestedAt       DateTime?
  lastTestStatus     String?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// One row per inbound webhook delivery.
//
// Two jobs: idempotency and forensics. deliveryId is unique, so a re-delivery of
// the same event is recognised and skipped rather than re-applied — Coolify's
// sender retries, and "delete this site" must not run twice. And because every
// delivery is recorded with its outcome, a skipped or failed event is visible
// afterwards instead of being a silent no-op in a log nobody keeps.
// Dedicated Stripe ledger: immutable deliveries and a per-subscription terminal
// fence. Intentionally independent of the shared operational WebhookEvent log.
model StripeSubscriptionEvent {
  eventId        String   @id
  eventType      String
  eventCreated   Int
  subscriptionId String
  customerId     String
  userId         String?  @db.Uuid
  outcome        String
  processedAt    DateTime @default(now())

  @@index([subscriptionId, eventCreated])
}

model StripeSubscriptionState {
  subscriptionId String  @id
  customerId     String
  userId         String  @db.Uuid
  providerCreated Int
  eventCreated   Int
  lastEventId    String
  terminal       Boolean @default(false)

  @@index([userId])
}

model WebhookEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  source     String // 'coolify'
  deliveryId String @unique
  eventType  String

  /// 'applied' | 'skipped' | 'failed' | 'throttled' | 'unmatched'
  outcome String
  /// Why it was skipped or how it failed. Null on a clean apply.
  detail  String?

  /// Coolify uuid(s) the delivery named.
  resourceUuids String[]
  /// Jongo Site ids actually affected. Empty when nothing matched.
  siteIds       String[] @db.Uuid

  receivedAt DateTime @default(now())

  @@index([source, receivedAt])
  @@index([outcome])
}

// Cached plugin inventory, read straight from the WordPress container.
//
// The REST collector (WordPressTelemetryConfig above) needs a per-site
// application password and had only ever been set up for a handful of apps, so
// the Plugins page was empty for most of the fleet. This is the credential-free
// path: a SHORTINIT probe over SSH + docker exec. Cached because the read costs
// an SSH round trip and a page render must not pay for it.
model WordPressPluginInventory {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId String @unique @db.Uuid

  collectedAt DateTime
  /// 'container_probe' today; named so a future source is distinguishable.
  source      String
  /// 'ok' when plugins were read; otherwise why not.
  status      String
  error       String?

  wpVersion           String?
  /// From WordPress's update_plugins transient. Old means "Up to date" is a
  /// stale cache rather than a fact — surfaced instead of silently trusted.
  updateDataCheckedAt DateTime?

  /// ProbedPlugin[] — see lib/wordpress-plugin-probe.ts.
  plugins Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([collectedAt])
}

// One row per site backup (Flywheel-style catalog entry). Each backup is a
// single restic snapshot in Backblaze B2 containing BOTH the WordPress files
// and a database dump, so it is independently restorable offsite.
model SiteBackup {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId       String @db.Uuid
  resourceUuid String // Coolify service UUID this backup belongs to

  label   String? // optional operator note
  // 'promote' is an on-demand backup that promote-to-production started itself
  // because the app had no restore point yet. Distinct from 'manual' so the
  // history shows who asked for it, and so failure alerting can tell them apart.
  trigger String // 'manual' | 'scheduled' | 'promote'
  status  String // 'running' | 'success' | 'failed'

  // Offsite locator: the restic snapshot in B2 that holds files + db dump.
  resticSnapshotId String?
  sizeBytes        BigInt?

  // What was captured (generalized beyond WordPress).
  resourceType   String? // 'wordpress' | 'service' | 'application' | 'database'
  volumeCount    Int?
  databaseCount  Int?
  // Tables actually captured across all dumps. Distinguishes "backed up a
  // database" from "backed up an EMPTY database": the latter is a valid,
  // complete, ~600-byte dump that would otherwise be reported as a healthy
  // restore point holding nothing.
  databaseTables Int?

  // WordPress-only content metadata (null for other resource types). Kept as
  // columns because they hold real history and the UI reads them; new stacks
  // use contentSummary rather than adding a column per framework.
  posts     Int?
  pages     Int?
  plugins   Int?
  comments  Int?
  wpVersion String?

  // Stack-agnostic record of what the host found: { stack, markers }, read by
  // lib/backup-stack.ts. A Next.js app reports a framework version where
  // WordPress reports posts and plugins, without either needing to know about
  // the other. Stores the MARKERS rather than the rendered metrics, so a later
  // fix to a label reaches existing backups instead of only new ones.
  contentSummary Json?

  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Restore tracking — set when this backup is restored FROM, so the UI can
  // report completion instead of firing and forgetting.
  restoreStatus      String? // 'running' | 'success' | 'failed'
  restoreStartedAt   DateTime?
  restoreCompletedAt DateTime?
  restoreError       String?
  safetySnapshotId   String? // restic snapshot of pre-restore state (rollback handle)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, startedAt])
  @@index([resourceUuid])
}

// Records the outcome of an end-to-end restore test for a Coolify database
// resource. Keyed by the Coolify resource UUID so each resource's DR status is
// independent (the jongo control-plane DB and each client DB are distinct).
// Written by scripts/verify-jongo-backup.mjs via /api/ops/backup-restore-verification.
model BackupRestoreVerification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceUuid   String   @unique // Coolify DB/service UUID that was restore-tested
  lastResult     String // 'pass' | 'fail'
  lastVerifiedAt DateTime
  rpoHours       Int      @default(26)
  restoreSeconds Int?
  offsitePresent String? // 'yes' | 'no' | 'unknown'
  rowsMatch      Boolean?
  rows           Json? // { restored: number[], live: number[] }
  detail         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([resourceUuid])
}

// ============================================================
// Environments
// ============================================================

model Environment {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId                 String  @db.Uuid
  name                   String // 'production', 'staging', 'development'
  coolifyEnvironmentName String? // maps to Coolify branch/environment
  isProductionLike       Boolean @default(false)

  // Relations
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, name])
  @@index([siteId])
}

// ============================================================
// Deployments
// ============================================================

model Deployment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId       String    @db.Uuid
  coolifyDeploymentId String? // external Coolify ID
  status              String // 'success', 'failed', 'in_progress', 'pending'
  triggeredById       String?   @db.Uuid
  triggeredAt         DateTime  @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  commitSha           String?
  commitMessage       String?
  logsUrl             String?

  // Relations
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  triggeredBy User?       @relation("TriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([environmentId])
  @@index([status])
  @@index([finishedAt])
}

// ============================================================
// Collaborators
// ============================================================

model Collaborator {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           CollaboratorRole @default(collaborator) // 'admin' or 'collaborator'
  grantedById    String?          @db.Uuid
  grantedAt      DateTime         @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model SiteCollaborator {
  id     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId String               @db.Uuid
  userId String               @db.Uuid
  role   SiteCollaboratorRole @default(collaborator) // 'admin' or 'collaborator' (team management at app level)

  // Relations
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
}

// ============================================================
// API Tokens
// ============================================================

model ApiToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  tokenHash      String    @unique
  name           String?
  lastUsedAt     DateTime?
  expiresAt      DateTime?

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([organizationId])
}

// ============================================================
// Audit Logs
// ============================================================

model AuditLog {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  actorId        String? @db.Uuid
  action         String // 'deploy_triggered', 'site_created', etc.
  resourceType   String?
  resourceId     String?
  details        Json?
  ipAddress      String?
  userAgent      String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

// ============================================================
// Password Reset Tokens
// ============================================================

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique // SHA-256 of the raw token sent in the email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// Invitations
// ============================================================

model Invitation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @db.Uuid
  siteId           String?   @db.Uuid
  email            String
  role             String
  tokenHash        String    @unique
  inviteType       String // 'organization' | 'site'
  invitedById      String?   @db.Uuid
  acceptedByUserId String?   @db.Uuid
  acceptedAt       DateTime?
  expiresAt        DateTime
  deliveryStatus   String    @default("not_configured") // 'not_configured' | 'sent' | 'failed'
  deliveryError    String?
  sentAt           DateTime?
  revokedAt        DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedByUser User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([siteId])
  @@index([email])
  @@index([inviteType])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
}

// ============================================================
// Security & Notifications (Jongo OS Malware Monitoring)
// ============================================================

enum SecurityFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// An SFTP account for one app's files volume.
//
// Its own table rather than columns on Site: an app may eventually need more
// than one account (agency plus client, or a time-limited one for a migration),
// and rotating or revoking one should not touch the Site row.
//
// password is stored in cleartext, deliberately and for the same reason as
// privacy mode: the dashboard shows the credential so an operator can hand it
// to a client, which a hash cannot support. SFTPGo keeps its own hashed copy —
// this one exists only to display.
model SftpAccount {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId   String @db.Uuid
  username String @unique
  password String
  // Absolute path inside the SFTP service that this account is confined to.
  homePath String

  // 'active' | 'failed' — whether the SFTP service actually reflects this row.
  status        String  @default("active")
  providerError String?

  createdBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastRotatedAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model SecurityScanResult {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId   String   @db.Uuid // Site or Server ID
  resourceType String   @default("site") // 'site', 'server', 'database'
  jobId        String? // Reference to Coolify task ID
  environment  String
  scanner      String // 'lmd-clamav', 'yara', 'fim'
  scannerMeta  Json? // { version: "1.0", signatures: "..." }
  scanType     String // 'malware', 'integrity'
  startTime    DateTime
  endTime      DateTime
  durationMs   Int
  filesScanned Int
  findings     Json // Array of { path, signature, severity: SecurityFindingSeverity, actionTaken }
  status       String // 'COMPLETED', 'FAILED'
  errorDetails String?
  createdAt    DateTime @default(now())

  @@index([resourceId, createdAt])
  @@index([status])
}

model NotificationChannel {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                  @db.Uuid
  provider        String // 'slack', 'email'
  config          Json // { webhookUrl: "..." } or { email: "..." }
  enabled         Boolean                 @default(true)
  minimumSeverity SecurityFindingSeverity @default(MEDIUM)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ============================================================
// Notifications & Admin Broadcasts (TSK-00951)
// ============================================================

// One row per recipient per event. Both system-generated (system_backup) and
// admin-authored (suspension/maintenance/general) notifications land here, so
// the tray and /notifications page have a single source to read.
model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  clientId    String?          @db.Uuid
  appId       String?          @db.Uuid
  broadcastId String?          @db.Uuid
  type        NotificationType @default(general)
  title       String
  message     String
  readAt      DateTime?
  // Hides a notification from the top-bar tray without deleting its history —
  // "Dismiss" and "Clear All" both set this rather than removing the row, so
  // the full /notifications page can still show everything under "All".
  dismissedAt DateTime?
  createdAt   DateTime         @default(now())

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Organization?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  app       Site?                  @relation(fields: [appId], references: [id], onDelete: SetNull)
  broadcast NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, dismissedAt, createdAt])
  @@index([userId, readAt])
  @@index([broadcastId])
}

// Reusable copy for the admin composer's template picker. Seeded with the
// three keys the composer ships with; admins are not expected to create new
// keys through the UI in this iteration, only fill in the two built-in ones.
model NotificationTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateKey  String   @unique
  subject      String
  bodyTemplate String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per "Compose Broadcast" send. Exists separately from Notification
// because a broadcast to "All Clients" can fan out to hundreds of recipient
// rows, and the admin's Activity History tab needs to show the send itself
// (who, what, how many, delivery mode) rather than one line per recipient.
model NotificationBroadcast {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy        String                   @db.Uuid
  templateKey      String?
  subject          String
  message          String
  deliveryMode     NotificationDeliveryMode @default(in_app)
  // { scope: "all" | "clients" | "apps" | "members", clientIds?, siteIds?, userIds? }
  recipientScope   Json
  recipientCount   Int                      @default(0)
  emailSentCount   Int                      @default(0)
  emailFailedCount Int                      @default(0)
  createdAt        DateTime                 @default(now())

  createdByUser User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([createdAt])
}

// A platform admin granted beyond the single BOOTSTRAP_ADMIN_EMAIL "seed"
// admin. The seed admin is env-configured, not a row here, and is the only
// one who may grant/revoke this table's rows (see lib/permissions.ts) --
// granting that power to any DB-added admin would let one compromised admin
// account mint arbitrarily many more.
model PlatformAdmin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @db.Uuid
  grantedBy String?  @db.Uuid
  createdAt DateTime @default(now())

  user        User  @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("PlatformAdminGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ============================================================
// Resource usage metering
// ============================================================
//
// Filled every few minutes by /api/ops/usage-collect from kernel counters on
// the Docker host (scripts/usage-collect.sh). Stored as HOURLY buckets rather
// than raw samples: CPU time and network bytes come from cumulative counters,
// so the delta between any two readings is exact and one row per app per hour
// loses nothing a 30/60/90-day view needs. Memory is a gauge, so each bucket
// keeps a running sum + sample count (for the average) and the peak.

/// One app (or one unattributed platform container group) for one hour.
model UsageHourly {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hourStart      DateTime
  host           String
  /// The Site id, or "infra:<name>" / "unmapped:<coolify uuid>" for containers
  /// that belong to no Jongo app — shown to admins as overhead, never to clients.
  subjectKey     String
  siteId         String?  @db.Uuid
  label          String
  /// CPU time used, in core-seconds (3600 = one vCPU busy for an hour).
  cpuCoreSeconds Float    @default(0)
  /// Sum of working-set bytes across samples; divide by memSamples for the mean.
  memSumBytes    BigInt   @default(0)
  memSamples     Int      @default(0)
  memPeakBytes   BigInt   @default(0)
  netRxBytes     BigInt   @default(0)
  netTxBytes     BigInt   @default(0)
  /// Transmit bytes of public-facing (Traefik-routed) containers only, so an
  /// app's traffic to its own database is not billed as egress.
  egressBytes    BigInt   @default(0)
  /// Persistent volume bytes, last measured within this hour (hourly job).
  diskBytes      BigInt?
  containers     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([hourStart, host, subjectKey])
  @@index([siteId, hourStart])
  @@index([hourStart])
}

/// Whole-server totals for one hour: the denominator for "share of server".
model UsageHostHourly {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hourStart        DateTime
  host             String
  /// Seconds of this hour covered by readings — the denominator for averages.
  coveredSeconds   Float    @default(0)
  cpuCores         Int
  cpuBusySeconds   Float    @default(0)
  memTotalBytes    BigInt
  memUsedSumBytes  BigInt   @default(0)
  memSamples       Int      @default(0)
  memUsedPeakBytes BigInt   @default(0)
  netRxBytes       BigInt   @default(0)
  netTxBytes       BigInt   @default(0)
  diskTotalBytes   BigInt
  diskUsedBytes    BigInt
  /// Free bytes for non-root users (df "avail") at the latest reading.
  diskAvailBytes    BigInt?
  /// Lowest free bytes seen in the hour: the hour's peak, measured like df and Coolify.
  diskAvailMinBytes BigInt?
  updatedAt        DateTime @updatedAt

  @@unique([hourStart, host])
  @@index([hourStart])
}

/// The last cumulative counters seen per container ("c:<id>"), per host
/// ("h:<host>") and the last disk sizing ("d:<host>"). Only used to compute
/// deltas; pruned when a container has not been seen for two days.
model UsageCounterState {
  key         String    @id
  host        String
  collectedAt DateTime
  startedAt   DateTime?
  cpuUsec     BigInt    @default(0)
  netRxBytes  BigInt    @default(0)
  netTxBytes  BigInt    @default(0)
  updatedAt   DateTime  @updatedAt

  @@index([collectedAt])
}

// ============================================================
// Domains (Namecheap registrar + Cloudflare DNS)
// ============================================================

// A domain a client owns through Jongo. Registered at Namecheap; DNS served by
// a Cloudflare zone whose nameservers Jongo sets at Namecheap.
model Domain {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String?   @db.Uuid
  name             String    @unique // lowercase, e.g. acme.org
  // pending_payment | registering | transfer_pending | active | failed | expired
  status           String    @default("pending_payment")
  registrar        String    @default("namecheap")
  registrarDomainId String?
  transferId       String?
  cloudflareZoneId String?
  nameservers      String[]  @default([])
  // pending | active | error: whether the domain resolves through Cloudflare yet
  dnsStatus        String?
  expiresAt        DateTime?
  autoRenew        Boolean   @default(false)
  isBillable       Boolean   @default(true)
  billingOverride  Boolean   @default(false)
  registrarSyncedAt DateTime?
  // Inventory/assignment does not authorize changing registrar nameservers.
  dnsManagementEnabled Boolean @default(false)
  lastError        String?
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  charges      DomainCharge[]

  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
}

// One purchase: a registration, renewal or transfer. All four price figures
// are stored as charged, so margin can be audited later against what Namecheap
// actually billed, whatever the markup is by then.
model DomainCharge {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainId                String    @db.Uuid
  operation               String // register | renew | transfer
  years                   Int
  // pending_payment | paid | fulfilling | fulfilled | failed | refunded | expired
  status                  String    @default("pending_payment")
  currency                String    @default("usd")
  wholesaleCents          Int // Namecheap cost quoted at checkout (price + ICANN fee)
  markupPercent           Float
  markupCents             Int
  clientCents             Int // what the client paid
  registrarChargedCents   Int? // what Namecheap actually charged (ChargedAmount)
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  stripeRefundId          String?
  registrarOrderId        String?
  registrarTransactionId  String?
  // Needed only until the order is placed, then cleared.
  registrantContact       Json?
  eppCode                 String?
  error                   String?
  createdById             String?   @db.Uuid
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  paidAt                  DateTime?
  fulfilledAt             DateTime?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([status])
}

// A client's own hostname for a site's staging copy (staging.clientsite.com),
// next to the always-working .mfts.link fallback. See
// docs/architecture/custom-staging-domains.md. Live hostnames are unique across
// the platform through a partial unique index (migration SQL), which Prisma
// cannot express.
model StagingDomain {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String    @db.Uuid
  hostname        String
  // pending_dns | verified | active | dns_lost | failed | removed
  status          String    @default("pending_dns")
  // none | pending | issued | failed
  sslStatus       String    @default("none")
  cnameTarget     String
  lastError       String?
  lastErrorReason String?
  lastCheckedAt   DateTime?
  verifiedAt      DateTime?
  attachedAt      DateTime?
  sslIssuedAt     DateTime?
  sslExpiresAt    DateTime?
  removedAt       DateTime?
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([hostname])
  @@index([status])
}

/// A Git source (GitHub App), like Coolify's Sources: a client may have several.
/// Added as a draft (name, optional organization = ownerLogin), then registered
/// on GitHub through the manifest flow (or filled in manually: manual = true),
/// then installed on repos. A row without organizationId is an optional shared
/// app. Secrets are encrypted with lib/secret-box.ts and never leave the server.
model GithubAppConfig {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String?  @db.Uuid
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installations         GithubInstallation[]
  appId                 Int?     @unique
  slug                  String?
  name                  String
  htmlUrl               String?
  clientId              String?
  clientSecretEnc       String?
  webhookSecretEnc      String?
  privateKeyEnc         String?
  coolifyPrivateKeyUuid String?
  ownerLogin            String?
  manual                Boolean  @default(false)
  createdById           String?  @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([organizationId])
}

/// A customer's install of the Jongo GitHub App. One install belongs to one
/// organization; each has its own private Coolify source.
model GithubInstallation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @db.Uuid
  installationId      BigInt    @unique
  accountLogin        String
  accountType         String
  accountId           BigInt?
  repositorySelection String?
  coolifySourceUuid   String?
  coolifySourceId     Int?
  githubAppConfigId   String?   @db.Uuid
  githubApp           GithubAppConfig? @relation(fields: [githubAppConfigId], references: [id], onDelete: SetNull)
  // active | suspended | removed
  status              String    @default("active")
  lastError           String?
  createdById         String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  removedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites        Site[]

  @@index([organizationId])
}

/// Seen webhook deliveries, so a GitHub redelivery never deploys twice.
model GithubWebhookDelivery {
  deliveryId String   @id
  event      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

/// A staging app's own database: a copy of one production platform database.
/// status: creating | copying | ready | failed | removed
model StagingDatabase {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId           String    @db.Uuid
  productionDbUuid String
  productionDbName String
  stagingDbUuid    String?
  engine           String
  status           String    @default("creating")
  lastCopiedAt     DateTime?
  lastError        String?
  tableCount       Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  removedAt        DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// ============================================================
// CMS persistence foundation (not a publishing/delivery system)
// SQL-only CHECK constraints and immutability triggers are documented in
// docs/cms-persistence.md. Preserve them in all future migrations.
// ============================================================

enum CmsDatasetRole {
  reader
  editor
  publisher
  admin
}

enum CmsDocumentVariant {
  draft
  published
}

enum CmsReferenceState {
  resolved
  unresolved
  excluded
  invalid
}

model CmsDataset {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  siteId         String?   @db.Uuid
  key            String    @db.Text
  environment    String    @db.Text
  name           String    @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site         Site?        @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  grants       CmsDatasetGrant[]
  documents    CmsDocument[]
  mutations    CmsMutation[]
  marketingReleases CmsMarketingRelease[]
  activeMarketingPublication CmsMarketingPublication?
  deliveryCredentials CmsDeliveryCredential[]
  contentOutbox CmsContentOutbox[]
  approvedMedia CmsApprovedMedia[]
  mediaCleanupJobs CmsMediaCleanupJob[]
  deliveryTargets CmsDeliveryTarget[]
  contentDeliveries CmsContentDelivery[]

  @@unique([organizationId, key, environment])
  @@index([siteId, organizationId])
}

enum CmsApprovedMediaStatus {
  pending
  approved
  revoked
}

/// Private server-owned verified rendition metadata, never a public DTO.
model CmsApprovedMedia {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId    String @db.Uuid
  nativeId     String @db.Text
  assetType    String @default("sanity.imageAsset") @db.Text
  objectKey    String @unique @db.Text
  url          String? @db.Text
  sha256       String @db.Text
  mimeType     String @db.Text
  width        Int
  height       Int
  byteSize     Int
  alt          String @db.Text
  caption      String @default("") @db.Text
  status       CmsApprovedMediaStatus @default(pending)
  reviewerId   String? @db.Uuid
  approvedAt   DateTime?
  createdBy    String @db.Uuid
  createdAt    DateTime @default(now())

  dataset CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation("CmsMediaCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer User? @relation("CmsMediaReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cleanupJob CmsMediaCleanupJob?

  @@unique([datasetId, id])
  @@unique([datasetId, nativeId])
  @@index([datasetId, status])
}

enum CmsMediaCleanupStatus {
  pending
  processing
  complete
}

/// Durable, retryable deletion + CDN purge intent created atomically with revocation.
model CmsMediaCleanupJob {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId     String   @db.Uuid
  mediaId       String   @unique @db.Uuid
  objectKey     String   @db.Text
  publicUrl     String   @db.Text
  status        CmsMediaCleanupStatus @default(pending)
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil    DateTime?
  leaseToken    String?  @db.Uuid
  lastError     String?  @db.Text
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dataset CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media   CmsApprovedMedia @relation(fields: [datasetId, mediaId], references: [datasetId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([datasetId, mediaId])
  @@index([status, nextAttemptAt])
}

model CmsDatasetGrant {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId String         @db.Uuid
  userId    String         @db.Uuid
  role      CmsDatasetRole @default(reader)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  revokedAt DateTime?

  dataset CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user    User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([datasetId, userId])
  @@index([userId])
}

model CmsDocument {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId         String             @db.Uuid
  /// Exact source _id (including drafts.); never a UUID or normalized ID.
  nativeId          String             @map("native_id") @db.Text
  type              String             @db.Text
  logicalId         String             @db.Text
  variant           CmsDocumentVariant
  slug              String?            @db.Text
  locale            String?            @db.Text
  currentRevisionId String?            @db.Uuid
  lockVersion       Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivedAt        DateTime?

  dataset         CmsDataset     @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions       CmsRevision[]  @relation("CmsDocumentRevisions")
  currentRevision CmsRevision?   @relation("CmsCurrentRevision", fields: [datasetId, id, currentRevisionId], references: [datasetId, documentId, id], onDelete: Restrict, onUpdate: Restrict)
  incomingRefs    CmsReference[] @relation("CmsReferenceTarget")

  @@unique([datasetId, nativeId])
  @@unique([datasetId, logicalId, variant])
  @@unique([datasetId, id])
  @@unique([datasetId, id, nativeId])
  @@index([datasetId, type, variant])
  @@index([datasetId, type, locale, slug])
  @@index([datasetId, id, currentRevisionId])
}

model CmsRevision {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId         String   @db.Uuid
  documentId        String   @db.Uuid
  sequence          Int
  schemaVersion     Int
  /// Opaque Jongo concurrency token; unrelated to the source _rev.
  nativeRev         String   @default(dbgenerated("gen_random_uuid()::text")) @db.Text
  sourceRev         String?  @db.Text
  /// Original opaque source date strings; never silently parsed/replaced.
  sourceCreatedAt   String?  @db.Text
  sourceUpdatedAt   String?  @db.Text
  payload           Json     @db.JsonB
  payloadSha256     String   @db.Text
  /// Exact eligible UTF-8 JSON record text, before JSONB normalization.
  sourceRecordRaw   String?  @db.Text
  sourceSha256      String?  @db.Text
  provenance        Json?    @db.JsonB
  actorId           String?  @db.Uuid
  mutationId        String?  @db.Uuid
  createdAt         DateTime @default(now())
  ingestedAt        DateTime @default(now())

  document       CmsDocument   @relation("CmsDocumentRevisions", fields: [datasetId, documentId], references: [datasetId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     CmsDocument[] @relation("CmsCurrentRevision")
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mutation       CmsMutation? @relation(fields: [datasetId, mutationId], references: [datasetId, id], onDelete: Restrict, onUpdate: Restrict)
  references     CmsReference[]

  @@unique([datasetId, id])
  @@unique([datasetId, documentId, id])
  @@unique([datasetId, documentId, sequence])
  @@unique([datasetId, nativeRev])
  @@index([actorId])
  @@index([datasetId, mutationId])
}

model CmsReference {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId        String            @db.Uuid
  sourceRevisionId String            @db.Uuid
  /// RFC 6901 JSON Pointer into the immutable source revision payload.
  path             String            @db.Text
  sourceRef        String            @db.Text
  weak             Boolean           @default(false)
  state            CmsReferenceState @default(unresolved)
  targetDocumentId String?           @db.Uuid
  diagnosticCode   String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  sourceRevision CmsRevision @relation(fields: [datasetId, sourceRevisionId], references: [datasetId, id], onDelete: Restrict, onUpdate: Restrict)
  targetDocument CmsDocument? @relation("CmsReferenceTarget", fields: [datasetId, targetDocumentId, sourceRef], references: [datasetId, id, nativeId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([datasetId, sourceRevisionId, path])
  @@index([datasetId, targetDocumentId, sourceRef])
  @@index([datasetId, state])
}

/// Transaction-local idempotency receipt, not an asynchronous job/queue.
model CmsMutation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId     String   @db.Uuid
  actorId       String   @db.Uuid
  key           String   @db.Text
  operation     String   @db.Text
  requestSha256 String   @db.Text
  result        Json     @db.JsonB
  createdAt     DateTime @default(now())

  dataset   CmsDataset    @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor     User          @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions CmsRevision[]

  @@unique([datasetId, id])
  @@unique([datasetId, key])
  @@index([actorId])
}

// ============================================================
// Marketing release/delivery storage only; no publish service or worker.
// SQL-only checks/triggers: docs/cms-release-delivery.md.
// ============================================================

enum CmsMarketingPublicationStatus {
  active
  revoked
}

enum CmsContentOutboxEventType {
  release_publish
  release_unpublish
}

enum CmsContentOutboxStatus {
  pending
  processing
  delivered
  failed
}

/// Immutable PUBLIC-SAFE projection, never an authoring/revision envelope.
model CmsMarketingRelease {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId       String   @db.Uuid
  sequence        Int
  version         Int      @default(1)
  /// Metadata mirror only: { documents: PublicMarketingDocument[] }. Never delivery bytes.
  payload         Json     @db.JsonB
  /// Exact JSON.stringify(documents); survives JSONB key-order normalization.
  snapshotText    String   @db.Text
  /// Lowercase SHA-256 of UTF-8 snapshotText; reader requires stringify(parse(text)) === text.
  payloadChecksum String   @db.Text
  actorId         String?  @db.Uuid
  createdAt       DateTime @default(now())

  dataset      CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publications CmsMarketingPublication[]
  outbox       CmsContentOutbox[]

  @@unique([datasetId, id])
  @@unique([datasetId, sequence])
  @@index([actorId])
}

/// Retained one-per-dataset CAS pointer; revoked requires releaseId=NULL.
model CmsMarketingPublication {
  datasetId String @id @db.Uuid
  releaseId String? @db.Uuid
  status    CmsMarketingPublicationStatus @default(revoked)
  revision  Int @default(0)
  actorId   String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataset CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release CmsMarketingRelease? @relation(fields: [datasetId, releaseId], references: [datasetId, id], onDelete: Restrict, onUpdate: Restrict)
  actor   User? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([datasetId, releaseId])
  @@index([actorId])
}

/// Dataset-scoped marketing.read only. No recoverable/full token or author API authority.
model CmsDeliveryCredential {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId String @db.Uuid
  type      String @default("marketing.read") @db.Text
  tokenHash String @unique @db.Text
  prefix    String @db.VarChar(16)
  expiresAt DateTime?
  revokedAt DateTime?
  actorId   String? @db.Uuid
  createdAt DateTime @default(now())

  dataset CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor   User? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([datasetId, revokedAt])
  @@index([actorId])
}

/// One logical event per publication revision, NOT per-target delivery receipts.
model CmsContentOutbox {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId           String @db.Uuid
  /// For unpublish, the release being removed; never the cleared pointer.
  releaseId           String @db.Uuid
  publicationRevision Int
  eventType           CmsContentOutboxEventType
  /// Public-safe event metadata only; no credentials, private source or signature secret.
  payload             Json @db.JsonB
  status              CmsContentOutboxStatus @default(pending)
  attempts            Int @default(0)
  nextAttemptAt       DateTime @default(now())
  deliveredAt         DateTime?
  /// Dispatcher lease (migration 20261020220000); set only while status = processing.
  leaseUntil          DateTime?
  leaseToken          String? @db.Uuid
  lastAttemptAt       DateTime?
  actorId             String? @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dataset    CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release    CmsMarketingRelease @relation(fields: [datasetId, releaseId], references: [datasetId, id], onDelete: Restrict, onUpdate: Restrict)
  actor      User? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries CmsContentDelivery[]

  @@unique([datasetId, publicationRevision])
  @@unique([datasetId, id])
  @@index([status, nextAttemptAt])
  @@index([datasetId, releaseId])
  @@index([actorId])
}

enum CmsContentDeliveryStatus {
  pending
  delivered
  dead
}

/// Operator-configured consumer endpoint. secretEnv names an env var; the secret is never stored.
model CmsDeliveryTarget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId  String   @db.Uuid
  consumerId String   @db.Text
  /// HTTPS only; SQL check permits plain HTTP solely for loopback test receivers.
  url        String   @db.Text
  secretEnv  String   @db.Text
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dataset    CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries CmsContentDelivery[]

  @@unique([datasetId, consumerId])
  @@unique([datasetId, id])
  @@index([datasetId, enabled])
}

/// Per-target delivery receipt for one logical outbox event.
model CmsContentDelivery {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId      String   @db.Uuid
  eventId        String   @db.Uuid
  targetId       String   @db.Uuid
  status         CmsContentDeliveryStatus @default(pending)
  attempts       Int      @default(0)
  lastStatusCode Int?
  lastError      String?  @db.Text
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dataset CmsDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  event   CmsContentOutbox @relation(fields: [datasetId, eventId], references: [datasetId, id], onDelete: Restrict, onUpdate: Restrict)
  target  CmsDeliveryTarget @relation(fields: [datasetId, targetId], references: [datasetId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([eventId, targetId])
  @@index([datasetId, eventId])
  @@index([datasetId, targetId])
}
