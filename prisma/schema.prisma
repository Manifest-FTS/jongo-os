// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum CollaboratorRole {
  admin
  collaborator
}

enum SiteCollaboratorRole {
  admin
  collaborator
}

// ============================================================
// Users and Authentication
// ============================================================

model User {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String    @unique
  emailVerified        Boolean   @default(false)
  emailVerifiedAt      DateTime?
  passwordHash         String?
  fullName             String?
  avatarUrl            String?
  authProvider         String? // 'local', 'github', 'google', etc.
  authProviderId       String? // external provider ID

  // Relations
  organizations        Organization[]
  collaborations       Collaborator[]
  siteCollaborations   SiteCollaborator[]
  apiTokens            ApiToken[]
  auditLogs            AuditLog[]
  deploymentsTriggered Deployment[] @relation("TriggeredBy")
  collaboratorsGranted Collaborator[] @relation("GrantedBy")
  invitationsSent      Invitation[]   @relation("InvitationInvitedBy")
  invitationsAccepted  Invitation[]   @relation("InvitationAcceptedBy")
  passwordResetTokens  PasswordResetToken[]

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([email])
  @@index([authProviderId])
}

// ============================================================
// Organizations
// ============================================================

model Organization {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String    @unique
  name             String
  description      String?
  logoUrl          String?
  ownerId          String    @db.Uuid
  coolifyApiUrl    String?   // optional per-org override
  coolifyProjectId String?   @unique
  coolifyProjectName String?

  // Relations
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sites            Site[]
  coolifyProjectLinks OrganizationCoolifyProjectLink[]
  collaborators    Collaborator[]
  invitations     Invitation[]
  apiTokens        ApiToken[]
  auditLogs        AuditLog[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([ownerId])
  @@index([slug])
  @@index([coolifyProjectName])
}

model OrganizationCoolifyProjectLink {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @db.Uuid
  coolifyProjectId  String
  coolifyProjectName String?
  isPrimary         Boolean   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, coolifyProjectId])
  @@index([organizationId])
  @@index([coolifyProjectId])
  @@index([coolifyProjectName])
}

// ============================================================
// Sites / Applications
// ============================================================

model Site {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @db.Uuid
  slug                String
  name                String
  description         String?
  coolifyServiceId    String?   // external Coolify service ID
  coolifyServiceUuid  String?   // Coolify service UUID
  coolifyProjectId    String?   // Coolify project UUID/ID for ownership mapping
  coolifyProjectName  String?
  gitRepositoryUrl    String?
  stagingEnabled      Boolean   @default(false)
  // Note: Site is referred to as "App" in UI/UX language

  // Relations
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments        Environment[]
  collaborators       SiteCollaborator[]
  invitations         Invitation[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([coolifyServiceId])
  @@index([coolifyProjectId])
  @@index([coolifyProjectName])
}

// ============================================================
// Environments
// ============================================================

model Environment {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId                  String    @db.Uuid
  name                    String    // 'production', 'staging', 'development'
  coolifyEnvironmentName  String?   // maps to Coolify branch/environment
  isProductionLike        Boolean   @default(false)

  // Relations
  site                    Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deployments             Deployment[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([siteId, name])
  @@index([siteId])
}

// ============================================================
// Deployments
// ============================================================

model Deployment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId         String    @db.Uuid
  coolifyDeploymentId   String?   // external Coolify ID
  status                String    // 'success', 'failed', 'in_progress', 'pending'
  triggeredById         String?   @db.Uuid
  triggeredAt           DateTime  @default(now())
  startedAt             DateTime?
  finishedAt            DateTime?
  commitSha             String?
  commitMessage         String?
  logsUrl               String?

  // Relations
  environment           Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  triggeredBy           User?       @relation("TriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([environmentId])
  @@index([status])
  @@index([finishedAt])
}

// ============================================================
// Collaborators
// ============================================================

model Collaborator {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  userId      String    @db.Uuid
  role        CollaboratorRole @default(collaborator) // 'admin' or 'collaborator'
  grantedById String?   @db.Uuid
  grantedAt   DateTime  @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model SiteCollaborator {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId      String    @db.Uuid
  userId      String    @db.Uuid
  role        SiteCollaboratorRole @default(collaborator) // 'admin' or 'collaborator' (team management at app level)

  // Relations
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
}

// ============================================================
// API Tokens
// ============================================================

model ApiToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid
  organizationId  String?   @db.Uuid
  tokenHash       String    @unique
  name            String?
  lastUsedAt      DateTime?
  expiresAt       DateTime?

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([userId])
  @@index([organizationId])
}

// ============================================================
// Audit Logs
// ============================================================

model AuditLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @db.Uuid
  actorId         String?   @db.Uuid
  action          String    // 'deploy_triggered', 'site_created', etc.
  resourceType    String?
  resourceId      String?
  details         Json?
  ipAddress       String?
  userAgent       String?

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor           User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

// ============================================================
// Password Reset Tokens
// ============================================================

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique  // SHA-256 of the raw token sent in the email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// Invitations
// ============================================================

model Invitation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @db.Uuid
  siteId           String?   @db.Uuid
  email            String
  role             String
  tokenHash        String    @unique
  inviteType       String    // 'organization' | 'site'
  invitedById      String?   @db.Uuid
  acceptedByUserId String?   @db.Uuid
  acceptedAt       DateTime?
  expiresAt        DateTime
  deliveryStatus   String    @default("not_configured") // 'not_configured' | 'sent' | 'failed'
  deliveryError    String?
  sentAt           DateTime?
  revokedAt        DateTime?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site             Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invitedBy        User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedByUser   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId])
  @@index([siteId])
  @@index([email])
  @@index([inviteType])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
}
