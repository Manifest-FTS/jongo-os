// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum CollaboratorRole {
  admin
  collaborator
}

enum SiteCollaboratorRole {
  admin
  collaborator
}

// ============================================================
// Users and Authentication
// ============================================================

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  passwordHash    String?
  fullName        String?
  avatarUrl       String?
  authProvider    String? // 'local', 'github', 'google', etc.
  authProviderId  String? // external provider ID

  // Relations
  profileSettings      UserProfileSettings?
  organizations        Organization[]
  collaborations       Collaborator[]
  siteCollaborations   SiteCollaborator[]
  apiTokens            ApiToken[]
  auditLogs            AuditLog[]
  favoriteApps         UserFavoriteApp[]
  deploymentsTriggered Deployment[]         @relation("TriggeredBy")
  collaboratorsGranted Collaborator[]       @relation("GrantedBy")
  invitationsSent      Invitation[]         @relation("InvitationInvitedBy")
  invitationsAccepted  Invitation[]         @relation("InvitationAcceptedBy")
  passwordResetTokens  PasswordResetToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([authProviderId])
}

model UserProfileSettings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @db.Uuid
  username    String?  @unique
  profileRole String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

model UserFavoriteApp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  appId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([userId])
  @@index([appId])
}

// ============================================================
// Organizations
// ============================================================

model Organization {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String  @unique
  name               String
  description        String?
  logoUrl            String?
  ownerId            String  @db.Uuid
  coolifyApiUrl      String? // optional per-org override
  coolifyProjectId   String? @unique
  coolifyProjectName String?

  // Relations
  owner               User                             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sites               Site[]
  coolifyProjectLinks OrganizationCoolifyProjectLink[]
  collaborators       Collaborator[]
  invitations         Invitation[]
  apiTokens           ApiToken[]
  auditLogs           AuditLog[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  NotificationChannel NotificationChannel[]

  @@index([ownerId])
  @@index([slug])
  @@index([coolifyProjectName])
}

model OrganizationCoolifyProjectLink {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @db.Uuid
  coolifyProjectId   String
  coolifyProjectName String?
  isPrimary          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, coolifyProjectId])
  @@index([organizationId])
  @@index([coolifyProjectId])
  @@index([coolifyProjectName])
}

// ============================================================
// Sites / Applications
// ============================================================

model Site {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String  @db.Uuid
  slug                  String
  name                  String
  description           String?
  coolifyServiceId      String? // external Coolify service ID
  coolifyServiceUuid    String? // Coolify service UUID
  coolifyProjectId      String? // Coolify project UUID/ID for ownership mapping
  coolifyProjectName    String?
  gitRepositoryUrl      String?
  stagingEnabled        Boolean @default(false)
  temporaryDomainSlug   String?
  temporaryDomainSuffix String?

  // Maintained by the hourly reconciler (see lib/platform-reconcile.ts).
  // isStagingResource: this Site's Coolify resource lives in a staging
  // environment, so it is a staging counterpart rather than a production app.
  // resourceMissingSince: its Coolify resource could not be found; set so the
  // UI can surface orphans instead of silently showing an empty app.
  isStagingResource    Boolean   @default(false)
  resourceMissingSince DateTime?

  // Scheduled backups. backupScheduleEnabled is nullable on purpose: null means
  // "follow the platform default", so the feature can be rolled out globally
  // without writing a row per site, while still allowing per-site opt-out.
  backupScheduleEnabled Boolean?
  backupFrequencyHours  Int       @default(24)
  lastScheduledBackupAt DateTime?
  // Cached answer to "does this resource have anything worth snapshotting?".
  // Null = never evaluated. Cached because the scheduler must not fan out an
  // API call per site every hour, and stale-by-a-day is harmless: the on-demand
  // path re-checks live before it ever starts a run.
  backupEligible        Boolean?
  backupEligibleAt      DateTime?
  // Why: "stateless", "external_database", "linked_database", ... Cached beside
  // backupEligible so the UI can decide what to show without a Coolify call on
  // every page load.
  backupCapabilityReason String?
  // Set on a database resource that belongs to another app: Coolify registers
  // standalone databases as their own resources, so they were imported as
  // peer apps and listed next to the app that owns them. Maintained by the
  // hourly reconciler from live Coolify links, so apps added later nest with
  // no manual step. Deliberately a plain id, not a relation, to avoid a
  // self-referential cascade on a table that is soft-deleted.
  parentSiteId          String?   @db.Uuid
  // When Coolify's backup schedules were last reconciled for this app. The
  // sweep re-checked all 43 apps every hour, which alone exceeds Coolify's
  // 200 requests/minute, starving everything that ran after it.
  scheduleCheckedAt     DateTime?
  // Rate limit for scheduled-backup failure email. A site that is broken fails
  // every night, and a nightly alert trains people to ignore alerts.
  backupAlertSentAt     DateTime?
  // Note: Site is referred to as "App" in UI/UX language

  // Relations
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments             Environment[]
  collaborators            SiteCollaborator[]
  invitations              Invitation[]
  wordpressTelemetryConfig WordPressTelemetryConfig?
  backups                  SiteBackup[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([coolifyServiceId])
  @@index([coolifyProjectId])
  @@index([coolifyProjectName])
}

model WordPressTelemetryConfig {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId             String    @unique @db.Uuid
  siteUrl            String
  username           String
  passwordCiphertext String
  lastTestedAt       DateTime?
  lastTestStatus     String?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// One row per site backup (Flywheel-style catalog entry). Each backup is a
// single restic snapshot in Backblaze B2 containing BOTH the WordPress files
// and a database dump, so it is independently restorable offsite.
model SiteBackup {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId       String @db.Uuid
  resourceUuid String // Coolify service UUID this backup belongs to

  label   String? // optional operator note
  trigger String // 'manual' | 'scheduled'
  status  String // 'running' | 'success' | 'failed'

  // Offsite locator: the restic snapshot in B2 that holds files + db dump.
  resticSnapshotId String?
  sizeBytes        BigInt?

  // What was captured (generalized beyond WordPress).
  resourceType  String? // 'wordpress' | 'service' | 'application' | 'database'
  volumeCount   Int?
  databaseCount Int?
  // Tables actually captured across all dumps. Distinguishes "backed up a
  // database" from "backed up an EMPTY database": the latter is a valid,
  // complete, ~600-byte dump that would otherwise be reported as a healthy
  // restore point holding nothing.
  databaseTables Int?

  // WordPress-only content metadata (null for other resource types).
  posts     Int?
  pages     Int?
  plugins   Int?
  comments  Int?
  wpVersion String?

  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Restore tracking — set when this backup is restored FROM, so the UI can
  // report completion instead of firing and forgetting.
  restoreStatus      String? // 'running' | 'success' | 'failed'
  restoreStartedAt   DateTime?
  restoreCompletedAt DateTime?
  restoreError       String?
  safetySnapshotId   String? // restic snapshot of pre-restore state (rollback handle)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, startedAt])
  @@index([resourceUuid])
}

// Records the outcome of an end-to-end restore test for a Coolify database
// resource. Keyed by the Coolify resource UUID so each resource's DR status is
// independent (the jongo control-plane DB and each client DB are distinct).
// Written by scripts/verify-jongo-backup.mjs via /api/ops/backup-restore-verification.
model BackupRestoreVerification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceUuid   String   @unique // Coolify DB/service UUID that was restore-tested
  lastResult     String // 'pass' | 'fail'
  lastVerifiedAt DateTime
  rpoHours       Int      @default(26)
  restoreSeconds Int?
  offsitePresent String? // 'yes' | 'no' | 'unknown'
  rowsMatch      Boolean?
  rows           Json? // { restored: number[], live: number[] }
  detail         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([resourceUuid])
}

// ============================================================
// Environments
// ============================================================

model Environment {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId                 String  @db.Uuid
  name                   String // 'production', 'staging', 'development'
  coolifyEnvironmentName String? // maps to Coolify branch/environment
  isProductionLike       Boolean @default(false)

  // Relations
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, name])
  @@index([siteId])
}

// ============================================================
// Deployments
// ============================================================

model Deployment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId       String    @db.Uuid
  coolifyDeploymentId String? // external Coolify ID
  status              String // 'success', 'failed', 'in_progress', 'pending'
  triggeredById       String?   @db.Uuid
  triggeredAt         DateTime  @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  commitSha           String?
  commitMessage       String?
  logsUrl             String?

  // Relations
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  triggeredBy User?       @relation("TriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([environmentId])
  @@index([status])
  @@index([finishedAt])
}

// ============================================================
// Collaborators
// ============================================================

model Collaborator {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           CollaboratorRole @default(collaborator) // 'admin' or 'collaborator'
  grantedById    String?          @db.Uuid
  grantedAt      DateTime         @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model SiteCollaborator {
  id     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId String               @db.Uuid
  userId String               @db.Uuid
  role   SiteCollaboratorRole @default(collaborator) // 'admin' or 'collaborator' (team management at app level)

  // Relations
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
}

// ============================================================
// API Tokens
// ============================================================

model ApiToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  tokenHash      String    @unique
  name           String?
  lastUsedAt     DateTime?
  expiresAt      DateTime?

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([organizationId])
}

// ============================================================
// Audit Logs
// ============================================================

model AuditLog {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  actorId        String? @db.Uuid
  action         String // 'deploy_triggered', 'site_created', etc.
  resourceType   String?
  resourceId     String?
  details        Json?
  ipAddress      String?
  userAgent      String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

// ============================================================
// Password Reset Tokens
// ============================================================

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique // SHA-256 of the raw token sent in the email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// Invitations
// ============================================================

model Invitation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @db.Uuid
  siteId           String?   @db.Uuid
  email            String
  role             String
  tokenHash        String    @unique
  inviteType       String // 'organization' | 'site'
  invitedById      String?   @db.Uuid
  acceptedByUserId String?   @db.Uuid
  acceptedAt       DateTime?
  expiresAt        DateTime
  deliveryStatus   String    @default("not_configured") // 'not_configured' | 'sent' | 'failed'
  deliveryError    String?
  sentAt           DateTime?
  revokedAt        DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedByUser User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([siteId])
  @@index([email])
  @@index([inviteType])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
}

// ============================================================
// Security & Notifications (Jongo OS Malware Monitoring)
// ============================================================

enum SecurityFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityScanResult {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId   String   @db.Uuid // Site or Server ID
  resourceType String   @default("site") // 'site', 'server', 'database'
  jobId        String? // Reference to Coolify task ID
  environment  String
  scanner      String // 'lmd-clamav', 'yara', 'fim'
  scannerMeta  Json? // { version: "1.0", signatures: "..." }
  scanType     String // 'malware', 'integrity'
  startTime    DateTime
  endTime      DateTime
  durationMs   Int
  filesScanned Int
  findings     Json // Array of { path, signature, severity: SecurityFindingSeverity, actionTaken }
  status       String // 'COMPLETED', 'FAILED'
  errorDetails String?
  createdAt    DateTime @default(now())

  @@index([resourceId, createdAt])
  @@index([status])
}

model NotificationChannel {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                  @db.Uuid
  provider        String // 'slack', 'email'
  config          Json // { webhookUrl: "..." } or { email: "..." }
  enabled         Boolean                 @default(true)
  minimumSeverity SecurityFindingSeverity @default(MEDIUM)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
