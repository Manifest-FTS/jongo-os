{
  "name": "jongo-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "description": "Open-source, self-hosted Jongo monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace @jongo-os/web",
    "start": "node ./scripts/start-production.mjs",
    "start:web": "npm run start --workspace @jongo-os/web",
    "build": "npm run prisma:generate && npm run build:web",
    "build:web": "npm run build --workspace @jongo-os/web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "bootstrap:local": "powershell -ExecutionPolicy Bypass -File ./scripts/bootstrap.ps1",
    "smoke:coolify": "node ./scripts/smoke-coolify.mjs",
    "smoke:staging-preflight": "node ./scripts/smoke-staging-preflight.mjs",
    "smoke:staging-promote": "node ./scripts/smoke-staging-promote.mjs",
    "dev:web:env": "powershell -ExecutionPolicy Bypass -File ./scripts/start-web-with-env.ps1 -Dev",
    "start:web:env": "powershell -ExecutionPolicy Bypass -File ./scripts/start-web-with-env.ps1",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:repair-legacy-ids": "node ./scripts/repair-legacy-ids.mjs",
    "db:repair-legacy-ids:apply": "node ./scripts/repair-legacy-ids.mjs --apply",
    "db:remediate-staging-enable": "node ./scripts/remediate-staging-enable.mjs",
    "db:remediate-staging-enable:apply": "node ./scripts/remediate-staging-enable.mjs --apply",
    "ops:remediate-staging-provision": "node ./scripts/remediate-staging-provision.mjs",
    "ops:remediate-staging-provision:apply": "node ./scripts/remediate-staging-provision.mjs --apply",
    "db:sync-approved-mappings": "node ./scripts/sync-approved-coolify-mappings.mjs",
    "db:sync-approved-mappings:apply": "node ./scripts/sync-approved-coolify-mappings.mjs --apply",
    "db:seed": "node prisma/seed.js",
    "create-admin": "node ./scripts/create-admin.mjs"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "turbo": "^2.0.6"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
